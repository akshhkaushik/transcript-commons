{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcript-commons.vercel.app/transcript-schema.json",
  "title": "Transcript Commons record",
  "description": "A timestamped, provenance-aware transcript of a source YouTube video.",
  "type": "object",
  "required": [
    "videoId",
    "title",
    "channel",
    "sourceUrl",
    "durationSeconds",
    "language",
    "topics",
    "transcriptSource",
    "ingestedAt",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "videoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "channelUrl": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "thumbnailUrl": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "transcriptSource": {
      "enum": [
        "creator-captions",
        "auto-captions",
        "local-asr"
      ]
    },
    "reviewStatus": {
      "enum": [
        "source-captions",
        "automated-unreviewed",
        "reviewed"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "reviewNotes": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "start",
          "duration",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
