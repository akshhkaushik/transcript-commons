{
  "name": "transcript-commons",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js dev",
    "prebuild": "npm run validate:content && npm run generate:data",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js start",
    "dev:vercel": "node node_modules/next/dist/bin/next dev",
    "prebuild:vercel": "npm run validate:content && npm run generate:data",
    "build:vercel": "node node_modules/next/dist/bin/next build --webpack",
    "start:vercel": "node node_modules/next/dist/bin/next start",
    "test": "npm run validate:content && npm run generate:data && node --test tests/product-contract.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "validate:content": "python3 scripts/validate_content.py",
    "generate:data": "python3 scripts/build_public_data.py",
    "check": "npm test && npm run lint && npm run build:vercel",
    "lint": "node node_modules/eslint/bin/eslint.js . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .venv",
    "worker:registry": "python3 scripts/registry_worker.py",
    "worker:check": "python3 scripts/registry_worker.py --check",
    "publish:registry": "python3 scripts/publish_registry.py",
    "seed:topics": "python3 scripts/seed_registry_topics.py",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
